# Copy to .env and fill in your local settings. Do not surround values with quotes.
DB_URL=jdbc:mysql://127.0.0.1:3306/anime?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASS=replace-with-your-local-mysql-password

PORT=8080
FRONTEND_URL=http://localhost:3000
# Generate a random signing secret containing at least 32 UTF-8 bytes.
JWT_SECRET=replace-with-a-random-signing-secret-of-at-least-32-bytes

# Startup placeholders for local password-login tests.
# Real provider credentials are required for Google/GitHub login.
GOOGLE_CLIENT_ID=local-test
GOOGLE_CLIENT_SECRET=local-test
GITHUB_CLIENT_ID=local-test
GITHUB_CLIENT_SECRET=local-test
